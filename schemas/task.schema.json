{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sbi/task.schema.json",
  "title": "Secure by Instruction task manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "language",
    "cwe",
    "source",
    "license",
    "commands"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "title": {"type": "string", "minLength": 5},
    "language": {"type": "string", "minLength": 1},
    "cwe": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CWE-[0-9]+$"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "revision", "retrieved_at"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "revision": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "evidence_url", "adaptation_allowed"],
      "properties": {
        "spdx": {"type": "string", "minLength": 1},
        "evidence_url": {"type": "string", "pattern": "^https://"},
        "adaptation_allowed": {"type": "boolean"}
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functional_test", "security_test"],
      "properties": {
        "setup": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "functional_test": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "security_test": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "notes": {"type": "string"}
  }
}

