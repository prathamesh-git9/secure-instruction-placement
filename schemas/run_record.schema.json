{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sbi/run_record.schema.json",
  "title": "Secure by Instruction run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "task_id",
    "condition",
    "agent",
    "model",
    "started_at",
    "functional_pass",
    "security_pass",
    "exit_state",
    "artifact_hash"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "condition": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "agent_version": {"type": "string"},
    "model": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "seed": {"type": ["integer", "null"]},
    "functional_pass": {"type": "boolean"},
    "security_pass": {"type": "boolean"},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "wall_seconds": {"type": ["number", "null"], "minimum": 0},
    "exit_state": {"enum": ["completed", "timeout", "agent_error", "harness_error"]},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "notes": {"type": "string"},
    "pilot_only": {"type": "boolean"},
    "upstream_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "target_path": {"type": "string", "minLength": 1},
    "metadata_target_mismatch": {"type": "boolean"},
    "metadata_targets": {"type": "array", "items": {"type": "string"}},
    "condition_materialization": {"type": "object"},
    "verifier_counts": {"type": "object"},
    "agent_exit_code": {"type": ["integer", "null"]},
    "command": {"type": "array", "items": {"type": "string"}},
    "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
